APP_NAME="ALMAZEN SMS API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.almazen.online

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_YE
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=single
LOG_LEVEL=warning

# MariaDB on the selected Hostinger plan is used through Laravel's mysql driver.
# Do not put the real database password in this example. Keep it only in the private server env file.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u893896051_ALMAZEN_SMS
DB_USERNAME=u893896051_ALMAZEN_SMS
DB_PASSWORD=replace-with-the-hpanel-database-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SESSION_COOKIE=almazen_sms_session

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=outbox
DB_QUEUE_RETRY_AFTER=90
FAILED_JOB_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
